{
  "debug": {
    "enabled": true,
    "dedup_window_seconds": 10,
    "feed_rate_threshold": 5000,
    "max_log_size_mb": 50
  },
  "models": {
    "haiku": "claude-haiku-4-5",
    "sonnet": "claude-sonnet-4-6"
  },
  "machine": {
    "xy_zero": "bottom-left",
    "z_zero": "spoilboard",
    "serial_port": "/dev/ttyUSB0",
    "baud_rate": 115200
  },
  "watch_folder": {
    "path": "/home/user/vcarve_output",
    "extensions": [".nc", ".gcode"]
  },
  "camera": {
    "device_index": 0,
    "capture_width": 1280,
    "capture_height": 720
  },
  "audio": {
    "sample_rate": 44100,
    "channels": 1,
    "chunk_size": 1024,
    "anomaly_threshold": 0.85,
    "baseline_duration_seconds": 30
  },
  "bits": {
    "warn_hours": 5.0,
    "profiles": {
      "default": {
        "hardness_factor": 1.0
      },
      "upcut_spiral_6mm": {
        "description": "6mm upcut spiral bit",
        "hardness_factor": 1.0,
        "total_hours": 0.0,
        "last_used": null
      }
    }
  },
  "approval_gate": {
    "enabled": true,
    "timeout_seconds": 300
  },
  "daily_insight": {
    "enabled": true,
    "hour": 18
  }
}
